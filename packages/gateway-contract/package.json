{
  "name": "@quietclaw/gateway-contract",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run generate:schemas",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && vitest run tests/unit/gateway-contract/contract.test.ts",
    "dev": "node -e \"console.log('gateway-contract exposes shared schemas and helpers')\"",
    "generate:schemas": "tsc -p tsconfig.json && node dist/jsonSchema.js"
  },
  "dependencies": {
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  }
}
